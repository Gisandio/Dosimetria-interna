      "source": [
        "t = df['time_h'].values\n",
        "A_RD = df['Rinon_D_MBq'].values\n",
        "A_RI = df['Rinon_I_MBq'].values\n",
        "\n",
        "# --- 1. Gráfico de retención ---\n",
        "plt.figure()\n",
        "plt.plot(t, A_RD, 'o-', label='Riñón Derecho (MBq)', linewidth=2)\n",
        "plt.plot(t, A_RI, 's-', label='Riñón Izquierdo (MBq)', linewidth=2)\n",
        "plt.title('Curva de Actividad vs Tiempo en Riñones')\n",
        "plt.xlabel('Tiempo post-administración (h)')\n",
        "plt.ylabel('Actividad (MBq)')\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# Función auxiliar para calcular los 4 métodos de AUC + bondad del ajuste (2d)\n",
        "def calcular_auc_rinon(t, A, nombre_organo, sigma_rel=0.05):\n",
        "    # 2a) Trapezoide sin corrección (t1 a t4)\n",
        "    auc_trap = np.trapezoid(A, t)\n",
        "\n",
        "    # 2b) Corrección lineal con los últimos 2 puntos (t3, A3) y (t4, A4)\n",
        "    pendiente = (A[-1] - A[-2]) / (t[-1] - t[-2])\n",
        "    ordenada = A[-1] - pendiente * t[-1]\n",
        "    t_corte = -ordenada / pendiente  # tiempo donde A(t) = 0\n",
        "    area_triangulo = 0.5 * (t_corte - t[-1]) * A[-1]\n",
        "    auc_lin = auc_trap + area_triangulo\n",
        "\n",
        "    # 2c) Corrección exponencial (decaimiento físico desde t4 a infinito)\n",
        "    area_cola_exp = A[-1] / lambda_fis\n",
        "    auc_exp = auc_trap + area_cola_exp\n",
        "\n",
        "    # 2d) Ajuste por cuadrados mínimos monoexponencial: A(t) = a * exp(-b * t)\n",
        "    func_mono = lambda x, a, b: a * np.exp(-b * x)\n",
        "    popt, _ = curve_fit(func_mono, t, A, p0=[A[0], 0.015])\n",
        "    a_fit, b_fit = popt\n",
        "    auc_lsq = a_fit / b_fit  # Integral analítica de 0 a infinito\n",
        "\n",
        "    # Bondad del ajuste: r y chi2 reducido\n",
        "    y_pred = func_mono(t, a_fit, b_fit)\n",
        "    residuos = A - y_pred\n",
        "    r_pred = np.corrcoef(A, y_pred)[0, 1]\n",
        "    r_log = np.corrcoef(t, np.log(A))[0, 1]\n",
        "\n",
        "    rss = np.sum(residuos ** 2)\n",
        "    dof = len(t) - len(popt)  # grados de libertad (4 - 2 = 2)\n",
        "    s2_res = rss / dof\n",
        "\n",
        "    sigma_i = sigma_rel * A\n",
        "    chi2_red = np.sum((residuos / sigma_i) ** 2) / dof\n",
        "\n",
        "    print(f'=== {nombre_organo} ===')\n",
        "    print(f'2a) Trapezoide sin corrección:          {auc_trap:.1f} MBq·h')\n",
        "    print(f'2b) Trapezoide + cola lineal:           {auc_lin:.1f} MBq·h (t_corte = {t_corte:.2f} h)')\n",
        "    print(f'2c) Trapezoide + cola exponencial fís.: {auc_exp:.1f} MBq·h (cola = {area_cola_exp:.1f} MBq·h)')\n",
        "    print(f'2d) Ajuste Mínimos Cuadrados (0->inf):  {auc_lsq:.1f} MBq·h  [A(t) = {a_fit:.2f} * exp(-{b_fit:.5f}*t)]')\n",
        "    print(f'    Bondad (2d): r(A, pred) = {r_pred:.4f} | '\n",
        "          f'chi2_red (sigma={sigma_rel*100:.0f}%, dof={dof}) = {chi2_red:.2f} | '\n",
        "          f'RSS/dof = {s2_res:.2f} MBq^2\\n')\n",
        "\n",
        "    return {\n",
        "        'trap': auc_trap, 'lin': auc_lin, 'exp': auc_exp, 'lsq': auc_lsq,\n",
        "        'popt': popt, 'r_pred': r_pred, 'r_log': r_log, 'chi2_red': chi2_red\n",
        "    }\n",
        "\n",
        "res_RD = calcular_auc_rinon(t, A_RD, 'RIÑÓN DERECHO', sigma_rel=0.05)\n",
        "res_RI = calcular_auc_rinon(t, A_RI, 'RIÑÓN IZQUIERDO', sigma_rel=0.05)\n",
        "\n",
        "# Gráfico comparativo del ajuste monoexponencial (2d)\n",
        "t_fino = np.linspace(0, 145, 200)\n",
        "plt.figure()\n",
        "plt.scatter(t, A_RD, color='tab:blue', label='Datos Riñón D')\n",
        "plt.plot(t_fino, res_RD['popt'][0] * np.exp(-res_RD['popt'][1] * t_fino), '--', color='tab:blue',\n",
        "         label=f\"Ajuste RD: {res_RD['popt'][0]:.2f}·exp(-{res_RD['popt'][1]:.4f}t) \"\n",
        "               f\"(r={res_RD['r_pred']:.4f}, χ²ᵥ={res_RD['chi2_red']:.2f})\")\n",
        "\n",
        "plt.scatter(t, A_RI, color='tab:orange', label='Datos Riñón I')\n",
        "plt.plot(t_fino, res_RI['popt'][0] * np.exp(-res_RI['popt'][1] * t_fino), '--', color='tab:orange',\n",
        "         label=f\"Ajuste RI: {res_RI['popt'][0]:.2f}·exp(-{res_RI['popt'][1]:.4f}t) \"\n",
        "               f\"(r={res_RI['r_pred']:.4f}, χ²ᵥ={res_RI['chi2_red']:.2f})\")\n",
        "\n",
        "plt.title('Ajuste Monoexponencial por Cuadrados Mínimos (0 a ∞)')\n",
        "plt.xlabel('Tiempo (h)')\n",
        "plt.ylabel('Actividad (MBq)')\n",
        "plt.legend()\n",
        "plt.show()"
      ]
    },
