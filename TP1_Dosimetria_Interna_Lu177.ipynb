        "func_mono = lambda x, a, b: a * np.exp(-b * x)\n",
        "popt_les, _ = curve_fit(func_mono, t, A_lesion, p0=[140, 0.005])\n",
        "a_les, b_les = popt_les\n",
        "A_tilde_lesion = a_les / b_les  # MBq·h\n",
        "\n",
        "# Gráfico con área sombreada bajo la curva\n",
        "t_ext = np.linspace(0, 150, 300)\n",
        "y_ext = func_mono(t_ext, a_les, b_les)\n",
        "\n",
        "plt.figure()\n",
        "plt.scatter(t, A_lesion, color='red', s=60, zorder=5, label='Datos SPECT/CT Lesión')\n",
        "plt.plot(t_ext, y_ext, 'b-', linewidth=2, label=f'Ajuste: {a_les:.2f} · exp(-{b_les:.4f}·t)')\n",
        "plt.fill_between(t_ext, y_ext, color='skyblue', alpha=0.35, label=f'AUC (0-∞) = {A_tilde_lesion:.1f} MBq·h')\n",
        "plt.title('Curva Tiempo-Actividad en Lesión Hepática (57 g)')\n",
