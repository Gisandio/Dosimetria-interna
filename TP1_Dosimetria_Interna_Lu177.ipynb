      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.optimize import curve_fit\n",
        "\n",
        "# Configuración visual de gráficos\n",
        "plt.rcParams['figure.figsize'] = (9, 5)\n",
        "plt.rcParams['axes.grid'] = True\n",
        "plt.rcParams['grid.alpha'] = 0.4\n",
        "\n",
        "# 1. Datos experimentales cuantificados por SPECT/CT (corregidos por decaimiento físico)\n",
        "datos = {\n",
        "    'time_h': [3.74111, 27.7253, 103.094, 123.741],\n",
        "    'Bazo_MBq': [76.4439, 79.1639, 37.3715, 25.1662],\n",
        "    'Rinon_D_MBq': [89.9996, 68.4121, 22.2228, 15.5858],\n",
        "    'Rinon_I_MBq': [94.2604, 74.3360, 24.9881, 15.7949],\n",
        "    'Higado_MBq': [263.672, 205.267, 107.993, 92.000],\n",
        "    'Vertebra_L4_MBq': [1.49457, 0.705426, 0.243188, 0.379583],\n",
        "    'Vertebra_L3_MBq': [1.34407, 0.405807, 0.258072, 0.274082],\n",
        "    'Vertebra_L2_MBq': [0.988745, 0.33229, 0.357996, 0.14114],\n",
        "    'Lesion_hepatica_MBq': [123.97, 142.28, 87.30, 76.79]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(datos)\n",
        "\n",
        "# Parámetros físicos y anatómicos del paciente\n",
        "A0_MBq = 7210.0           # 7.21 GBq\n",
        "T_half_h = 6.65 * 24      # 159.6 horas\n",
        "lambda_fis = np.log(2) / T_half_h  # ~0.004343 h^-1\n",
        "\n",
        "masa_RD = 230.877         # g\n",
        "masa_RI = 237.007         # g\n",
        "masa_rinones_pac = masa_RD + masa_RI  # 467.884 g\n",
        "masa_rinones_ref = 422.0  # g (fantoma ICRP 110 AM con sangre)\n",
        "masa_lesion = 57.0        # g\n",
        "\n",
        "df"
      ]
